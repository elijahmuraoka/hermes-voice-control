diff --git a/scripts/validate-env.test.mjs b/scripts/validate-env.test.mjs
new file mode 100644
index 0000000..dc05ce1
--- /dev/null
+++ b/scripts/validate-env.test.mjs
@@ -0,0 +1,39 @@
+import assert from "node:assert/strict";
+import { spawnSync } from "node:child_process";
+import { test } from "node:test";
+
+function validateEnv(env = {}) {
+  return spawnSync(process.execPath, ["scripts/validate-env.mjs"], {
+    cwd: new URL("..", import.meta.url),
+    env: {
+      ...process.env,
+      HVC_GEMINI_MODE: "mock",
+      HVC_HERMES_ADAPTER: "mock",
+      ...env,
+    },
+    encoding: "utf8",
+  });
+}
+
+test("env validation allows Hermes API adapter with a valid API URL", () => {
+  const result = validateEnv({
+    HVC_HERMES_ADAPTER: "api",
+    HVC_HERMES_API_URL: "http://127.0.0.1:8642",
+  });
+  assert.equal(result.status, 0, result.stderr || result.stdout);
+  const body = JSON.parse(result.stdout);
+  assert.equal(body.ok, true);
+  assert.equal(body.mode.hermesAdapter, "api");
+  assert.equal(body.mode.hermesApiUrl, "http://127.0.0.1:8642");
+});
+
+test("env validation rejects invalid Hermes API adapter URLs", () => {
+  const result = validateEnv({
+    HVC_HERMES_ADAPTER: "api",
+    HVC_HERMES_API_URL: "not-a-url",
+  });
+  assert.notEqual(result.status, 0);
+  const body = JSON.parse(result.stdout);
+  assert.equal(body.ok, false);
+  assert.match(body.errors.join("\n"), /HVC_HERMES_API_URL/);
+});
