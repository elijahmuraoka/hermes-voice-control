+
+class HermesApiAdapter(HermesAdapter):
+    def __init__(
+        self,
+        api_url: str = DEFAULT_HERMES_API_URL,
+        api_key: str | None = None,
+        timeout_seconds: int = DEFAULT_HERMES_API_TIMEOUT_SECONDS,
+        agent_name: str = DEFAULT_AGENT_NAME,
+        source: str = DEFAULT_SOURCE,
+    ):
+        self.api_url = api_url.rstrip("/")
+        self.api_key = api_key or None
+        self.timeout_seconds = timeout_seconds
+        self.agent_name = agent_name
+        self.source = source
+
+    def _responses_url(self) -> str:
+        return f"{self.api_url}/v1/responses"
+
+    def diagnostics(self) -> dict:
+        parsed = parse.urlparse(self.api_url)
+        return {
+            "kind": "api",
+            "available": bool(parsed.scheme and parsed.hostname),
+            "scheme": parsed.scheme,
+            "host": parsed.hostname,
+            "port": parsed.port,
+            "base_path": parsed.path or "",
+            "auth_configured": bool(self.api_key),
+            "timeout_seconds": self.timeout_seconds,
+        }
+
+    def _build_body(self, message: str, mode: str, transcript_window: list[dict] | None) -> dict:
+        body: dict = {
+            "input": message,
+            "source": self.source,
+            "metadata": {
+                "client": "hvc",
+                "mode": mode,
+                "agent_name": self.agent_name,
+                "transcript_items": len(transcript_window or []),
+            },
+        }
+        return body
+
+    def _extract_named_text(self, payload: dict, keys: tuple[str, ...]) -> str | None:
+        for key in keys:
+            value = payload.get(key)
+            if isinstance(value, str) and value.strip():
+                return value
+        for nested_key in ("result", "response"):
+            nested = payload.get(nested_key)
+            if isinstance(nested, dict):
+                value = self._extract_named_text(nested, keys)
+                if value:
+                    return value
+        return None
+
+    def _extract_text(self, payload: dict) -> str | None:
+        for key in ("output_text", "display_text", "text"):
+            value = payload.get(key)
+            if isinstance(value, str) and value.strip():
+                return value
+        content = payload.get("content")
+        if isinstance(content, str) and content.strip():
+            return content
+        response = payload.get("response")
+        if isinstance(response, dict):
+            nested = self._extract_text(response)
+            if nested:
+                return nested
+        output = payload.get("output")
+        if isinstance(output, list):
+            parts: list[str] = []
+            for item in output:
+                if not isinstance(item, dict):
+                    continue
+                item_content = item.get("content")
+                if isinstance(item_content, str) and item_content.strip():
+                    parts.append(item_content)
+                elif isinstance(item_content, list):
+                    for block in item_content:
+                        if not isinstance(block, dict):
+                            continue
+                        text = block.get("text") or block.get("output_text")
+                        if isinstance(text, str) and text.strip():
+                            parts.append(text)
+                text = item.get("text")
+                if isinstance(text, str) and text.strip():
+                    parts.append(text)
+            if parts:
+                return "\n".join(parts)
+        choices = payload.get("choices")
+        if isinstance(choices, list) and choices:
+            first = choices[0]
+            if isinstance(first, dict):
+                message = first.get("message")
+                if isinstance(message, dict):
+                    content = message.get("content")
+                    if isinstance(content, str) and content.strip():
+                        return content
+        return None
+
+    def _extract_response_id(self, payload: dict) -> str | None:
+        for key in ("id", "response_id", "previous_response_id"):
+            value = payload.get(key)
+            if isinstance(value, str) and value:
+                return value
+        response = payload.get("response")
+        if isinstance(response, dict):
+            return self._extract_response_id(response)
+        return None
+
+    def ask_agent(self, message: str, mode: str = "quick", transcript_window: list[dict] | None = None, should_cancel: Callable[[], bool] | None = None) -> AdapterResult:
+        if should_cancel and should_cancel():
+            return AdapterResult(ok=False, error_code="HERMES_CANCELLED", safe_message="Tool call was cancelled.")
+        headers = {"Content-Type": "application/json"}
+        if self.api_key:
+            headers["Authorization"] = f"Bearer {self.api_key}"
+        body = self._build_body(message, mode, transcript_window)
+        req = request.Request(
+            self._responses_url(),
+            data=json.dumps(body).encode("utf-8"),
+            headers=headers,
+            method="POST",
+        )
+        try:
+            with request.urlopen(req, timeout=self.timeout_seconds) as resp:
+                raw = resp.read().decode("utf-8")
+        except error.HTTPError as exc:
+            code = "HERMES_AUTH_FAILED" if exc.code == 401 else "HERMES_API_ERROR"
+            return AdapterResult(ok=False, error_code=code, safe_message="The Hermes agent could not answer right now.")
+        except TimeoutError:
+            return AdapterResult(ok=False, error_code="HERMES_TIMEOUT", safe_message="The Hermes agent took too long to answer.")
+        except error.URLError:
+            return AdapterResult(ok=False, error_code="HERMES_API_UNAVAILABLE", safe_message="The Hermes agent could not be reached right now.")
+        except OSError:
+            return AdapterResult(ok=False, error_code="HERMES_API_ERROR", safe_message="The Hermes agent could not answer right now.")
+        try:
+            payload = json.loads(raw)
+        except json.JSONDecodeError:
+            return AdapterResult(ok=False, error_code="HERMES_MALFORMED_OUTPUT", safe_message="Hermes returned a malformed response.")
+        if not isinstance(payload, dict):
+            return AdapterResult(ok=False, error_code="HERMES_MALFORMED_OUTPUT", safe_message="Hermes returned a malformed response.")
+        display = self._extract_named_text(payload, ("display_text", "display")) or self._extract_text(payload)
+        if not display:
+            return AdapterResult(ok=False, error_code="HERMES_MALFORMED_OUTPUT", safe_message="Hermes returned an empty response.")
+        speakable = self._extract_named_text(payload, ("speakable_text", "speakable")) or display
+        data = {"speakable": speakable, "display": display, "mode": mode}
+        response_id = self._extract_response_id(payload)
+        if response_id:
+            data["response_id"] = response_id
+        return AdapterResult(ok=True, data=data)
+
+def build_adapter(
+    kind: str,
+    hermes_bin: str,
+    timeout_seconds: int = DEFAULT_HERMES_TIMEOUT_SECONDS,
+    toolsets: tuple[str, ...] = DEFAULT_TOOLSETS,
+    source: str = DEFAULT_SOURCE,
+    agent_name: str = DEFAULT_AGENT_NAME,
+    api_url: str = DEFAULT_HERMES_API_URL,
+    api_key: str | None = None,
+    api_timeout_seconds: int = DEFAULT_HERMES_API_TIMEOUT_SECONDS,
+) -> HermesAdapter:
+    if kind == "local":
+        return LocalHermesAdapter(
+            hermes_bin,
+            timeout_seconds=timeout_seconds,
+            toolsets=toolsets,
+            source=source,
+            agent_name=agent_name,
+        )
+    if kind == "api":
+        return HermesApiAdapter(
+            api_url=api_url,
+            api_key=api_key,
+            timeout_seconds=api_timeout_seconds,
+            agent_name=agent_name,
+            source=source,
+        )
+    if kind == "mock":
+        return MockHermesAdapter(agent_name=agent_name)
+    raise ValueError(f"Unsupported Hermes adapter: {kind}")
