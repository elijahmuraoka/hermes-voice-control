HVC_HOST=127.0.0.1
HVC_PORT=8765
HVC_ALLOW_REMOTE_BIND=false
HVC_FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
HVC_REQUIRE_PIN=false
HVC_PIN=change-me
HVC_SESSION_TTL_SECONDS=86400
HVC_GEMINI_MODE=mock
HVC_GEMINI_MODEL=gemini-2.5-flash-native-audio-latest
# GEMINI_API_KEY=...
# GOOGLE_API_KEY=...
HVC_HERMES_ADAPTER=mock
HVC_HERMES_BIN=hermes
HVC_HERMES_TIMEOUT_SECONDS=90
HVC_ALLOW_LOGS_ENDPOINT=false
HVC_AUDIT_LOG_RETENTION_DAYS=30
HVC_AUDIT_LOG_MAX_ROWS=5000
HVC_SECURE_COOKIES=false
HVC_DEBUG_ERRORS=false
HVC_TAILSCALE_HOSTNAME=DEVICE.TAILNET.ts.net
VITE_HVC_AGENT_NAME=Hermes Agent
