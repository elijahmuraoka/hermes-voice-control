+
+async function dragTranscriptDrawer(page: Page, snap: "open" | "peeking") {
+  const drawer = page.locator(".transcript");
+  const tab = page.getByRole("button", { name: /Toggle transcript/ });
+  const [drawerBox, tabBox] = await Promise.all([
+    drawer.boundingBox(),
+    tab.boundingBox(),
+  ]);
+  if (!drawerBox || !tabBox) {
+    throw new Error("Transcript drawer was not available for dragging");
+  }
+
+  const travel = Math.max(
+    140,
+    Math.round((drawerBox.height - tabBox.height) * 0.62),
+  );
+  const startX = tabBox.x + tabBox.width / 2;
+  const startY = tabBox.y + Math.min(tabBox.height / 2, 32);
+  const endY = snap === "open" ? startY - travel : startY + travel;
+
+  await page.mouse.move(startX, startY);
+  await page.mouse.down();
+  await page.mouse.move(startX, endY, { steps: 8 });
+  await page.mouse.up();
+}
